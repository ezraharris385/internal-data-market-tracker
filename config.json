  "modules": {
    "Capital Investment": {
      "metrics": [
        {
          "label": "CapEx budget",
          "col": "CapEx Budget ($)",
          "agg": "sum",
          "fmt": "usd0"
        },
        {
          "label": "CapEx spent",
          "col": "CapEx Spent ($)",
          "agg": "sum",
          "fmt": "usd0"
        },
        {
          "label": "Active projects",
          "col": "Capital Project",
          "agg": "count"
        },
        {
          "label": "Avg budget / property",
          "col": "CapEx Budget ($)",
          "agg": "avg",
          "fmt": "usd0"
        }
      ],
      "chart": {
        "col": "CapEx Budget ($)",
        "agg": "sum",
        "label": "CapEx budget by submarket"
      },
      "cols": [
        "Capital Project",
        "Capital Project Status",
        "CapEx Budget ($)",
        "CapEx Spent ($)",
        "Year Renovated"
      ]
    },
    "Leasing": {
      "metrics": [
        {
          "label": "Available SF",
          "col": "Available SF",
          "agg": "sum",
          "fmt": "int"
        },
        {
          "label": "Largest contiguous",
          "col": "Largest Contiguous SF",
          "agg": "max",
          "fmt": "int"
        },
        {
          "label": "Avg WALT",
          "col": "WALT (yrs)",
          "agg": "avg",
          "fmt": "num"
        },
        {
          "label": "Avg asking rent",
          "col": "Asking Rent ($/SF)",
          "agg": "avg",
          "fmt": "usd"
        },
        {
          "label": "Avg escalations",
          "col": "Escalations (%/yr)",
          "agg": "avg",
          "fmt": "pct"
        },
        {
          "label": "Avg TI allowance",
          "col": "TI Allowance ($/SF)",
          "agg": "avg",
          "fmt": "usd"
        }
      ],
      "chart": {
        "col": "Available SF",
        "agg": "sum",
        "label": "Available SF by submarket"
      },
      "cols": [
        "Available SF",
        "Largest Contiguous SF",
        "WALT (yrs)",
        "# Tenants",
        "Asking Rent ($/SF)",
        "Rent Basis",
        "Avg Lease Term (yrs)",
        "Escalations (%/yr)",
        "TI Allowance ($/SF)",
        "Free Rent (mos)",
        "Renewal Options",
        "Largest Tenant",
        "Largest Tenant SF",
        "Next Major Expiry",
        "Occupancy %"
      ]
    },
    "Operations": {
      "metrics": [
        {
          "label": "Total NOI",
          "col": "NOI ($)",
          "agg": "sum",
          "fmt": "usd0"
        },
        {
          "label": "Avg in-place rent",
          "col": "In-Place Rent ($/SF)",
          "agg": "avg",
          "fmt": "usd"
        },
        {
          "label": "Avg OpEx",
          "col": "OpEx ($/SF)",
          "agg": "avg",
          "fmt": "usd"
        },
        {
          "label": "Avg RE taxes",
          "col": "RE Taxes ($/SF)",
          "agg": "avg",
          "fmt": "usd"
        }
      ],
      "chart": {
        "col": "NOI ($)",
        "agg": "sum",
        "label": "NOI by submarket"
      },
      "cols": [
        "NOI ($)",
        "In-Place Rent ($/SF)",
        "Asking Rent ($/SF)",
        "OpEx ($/SF)",
        "RE Taxes ($/SF)",
        "Insurance ($/SF)",
        "Occupancy %"
      ]
    },
    "Development": {
      "metrics": [
        {
          "label": "Projects in pipeline",
          "col": "Developer",
          "agg": "count"
        },
        {
          "label": "Pipeline SF",
          "col": "Building SF",
          "agg": "sum",
          "fmt": "int",
          "where": {
            "col": "Status",
            "in": [
              "Under Construction",
              "Proposed"
            ]
          }
        },
        {
          "label": "Under construction",
          "col": "Status",
          "agg": "countValue",
          "value": "Under Construction"
        },
        {
          "label": "Proposed",
          "col": "Status",
          "agg": "countValue",
          "value": "Proposed"
        }
      ],
      "chart": {
        "col": "Building SF",
        "agg": "sum",
        "label": "Pipeline SF by submarket",
        "where": {
          "col": "Status",
          "in": [
            "Under Construction",
            "Proposed"
          ]
        }
      },
      "cols": [
        "Status",
        "Developer",
        "Construction Start",
        "Est. Delivery",
        "Building SF",
        "Land Acres"
      ],
      "rowFilter": {
        "col": "Status",
        "in": [
          "Under Construction",
          "Proposed"
        ]
      }
    },
    "Renovations": {
      "metrics": [
        {
          "label": "Renovated properties",
          "col": "Year Renovated",
          "agg": "count"
        },
        {
          "label": "Renovation spend",
          "col": "Renovation Budget ($)",
          "agg": "sum",
          "fmt": "usd0"
        },
        {
          "label": "Avg renovation year",
          "col": "Year Renovated",
          "agg": "avg",
          "fmt": "year"
        }
      ],
      "chart": {
        "col": "Renovation Budget ($)",
        "agg": "sum",
        "label": "Renovation spend by submarket"
      },
      "cols": [
        "Year Renovated",
        "Renovation Budget ($)",
        "Renovation Scope",
        "Year Built",
        "Class"
      ],
      "rowFilter": {
        "col": "Year Renovated",
        "nonEmpty": true
      }
    },
    "Sales": {
      "metrics": [
        {
          "label": "Total sale volume",
          "col": "Last Sale Price",
          "agg": "sum",
          "fmt": "usd0"
        },
        {
          "label": "Avg price/SF",
          "col": "Price/SF",
          "agg": "avg",
          "fmt": "usd"
        },
        {
          "label": "Avg cap rate",
          "col": "Cap Rate (%)",
          "agg": "avg",
          "fmt": "pct"
        },
        {
          "label": "Trades recorded",
          "col": "Last Sale Price",
          "agg": "count"
        }
      ],
      "chart": {
        "col": "Last Sale Price",
        "agg": "sum",
        "label": "Sale volume by submarket"
      },
      "cols": [
        "Last Sale Price",
        "Last Sale Date",
        "Price/SF",
        "Cap Rate (%)",
        "Buyer",
        "Seller",
        "Total Basis ($)",
        "JV Partner",
        "Ownership %"
      ]
    },
    "Financing": {
      "metrics": [
        {
          "label": "Total debt",
          "col": "Loan Amount ($)",
          "agg": "sum",
          "fmt": "usd0"
        },
        {
          "label": "Avg rate",
          "col": "Interest Rate (%)",
          "agg": "avg",
          "fmt": "pct"
        },
        {
          "label": "Avg LTV",
          "col": "LTV (%)",
          "agg": "avg",
          "fmt": "pct"
        },
        {
          "label": "Avg DSCR",
          "col": "DSCR",
          "agg": "avg",
          "fmt": "num"
        },
        {
          "label": "Avg debt yield",
          "col": "Debt Yield (%)",
          "agg": "avg",
          "fmt": "pct"
        },
        {
          "label": "Loans on file",
          "col": "Loan Amount ($)",
          "agg": "count"
        }
      ],
      "chart": {
        "col": "Loan Amount ($)",
        "agg": "sum",
        "label": "Debt by submarket"
      },
      "cols": [
        "Lender",
        "Loan Amount ($)",
        "Loan Type",
        "Index",
        "Spread (bps)",
        "Interest Rate (%)",
        "Amortization (yrs)",
        "IO Period (mos)",
        "DSCR",
        "Debt Yield (%)",
        "LTV (%)",
        "Origination Date",
        "Loan Maturity",
        "Prepayment",
        "Recourse"
      ]
    }
  },
  "basemap": {
    "style": "https://tiles.openfreemap.org/styles/liberty",
    "satelliteTiles": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
